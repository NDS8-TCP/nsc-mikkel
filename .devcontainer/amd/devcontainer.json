// https://containers.dev/implementors/json_reference/
{
    "name": "nsc-amd",

    // Image specific properties
    "build": {
        "dockerfile": "../Containerfile", 
        "context": "../..", // Use the project root dir instead of .devcontainer
        "args": {
             // Omit for no opencl ICDs
            "OPENCL_SUPPORT": "1",

            // Supported platforms: intel-x86_64, cpu, nvidia, amd, intel
            "OPENCL_PLATFORM": "intel-x86_64 amd"
        }
    },

    // Mount the source code to /ncs instead of its default
    "workspaceMount": "source=${localWorkspaceFolder},target=/ncs,type=bind", 
    "workspaceFolder": "/ncs",

    // Port forward, used for lecture 6 dask dashboard
    "forwardPorts": [8787],

    // Tool-specific properties
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter",
                "ms-python.isort",
                "ms-python.debugpy",
                "ms-python.autopep8",
                "ms-azuretools.vscode-containers",
                "streetsidesoftware.code-spell-checker",
                "galarius.vscode-opencl"
            ]
        }
    },

    // Allow GPU access via the CDI interface
    // AMD
    "runArgs": [
        "--device", "amd.com/gpu=all"
    ]
}